# ============================================================
# TESL 1315 — local environment variables
# Copy this file to `.env` and fill in your own values.
# Never commit a real `.env` file.
# ============================================================

# Gate password shown on the pre-app access screen.
# Anyone who reads `.env` can see this value — keep it private
# if you ever share the repo.
VITE_APP_KEY=kuda

# ------------------------------------------------------------
# Cesium Ion access token
# ------------------------------------------------------------
# Required to load the default Bing satellite imagery + world
# terrain. Sign up (free) at https://ion.cesium.com and create
# a token under "Access Tokens", then paste it below.
#
# If you do NOT provide a token:
#   • The cinematic intro will use Cesium's open Natural Earth
#     imagery as a graceful fallback.
#   • Photorealistic 3D Tiles and Cesium World Terrain will
#     be unavailable — only the basic 2D satellite basemap is
#     guaranteed to load.
#
# The token is exposed to the client (it has to be — Cesium
# loads assets from the browser). That is normal for Cesium
# projects; rotate it on the Cesium dashboard if it leaks.
VITE_CESIUM_ION_TOKEN=
